# ─────────────────────────────────────────────────────────────
# Greenscape Pro — Closed-Lost Lead Reactivation Agent
# Copy to .env.local for local dev; set the same keys in Vercel.
# ─────────────────────────────────────────────────────────────

# ---- Supabase (required) ----
# Project Settings → API. The service role key is server-only and must
# NEVER be exposed to the browser. It is only read inside API routes.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Anthropic (required) ----
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Haiku is the right tier for short, high-volume drafting.
# Override if your account exposes a newer Haiku alias.
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Per-million-token pricing used for the cost figures shown in the UI.
ANTHROPIC_INPUT_COST_PER_MTOK=0.80
ANTHROPIC_OUTPUT_COST_PER_MTOK=4.00

# ---- Resend (required for real sends) ----
# resend.com → API Keys. FROM must be on a domain you have verified.
# If RESEND_API_KEY is unset the app runs in DRY_RUN: it records the send
# and marks the message sent, but no email leaves the building.
RESEND_API_KEY=re_...
RESEND_FROM="Marcus Tate <marcus@mail.greenscapepro.com>"
RESEND_REPLY_TO=marcus@greenscapepro.com

# ---- Slack (optional but recommended) ----
# Incoming webhook. Makes human-in-the-loop real: a person gets pinged
# when a draft is waiting, rather than being expected to check a dashboard.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# ---- App ----
# Recorded as approved_by on every approved message (audit trail).
APPROVER_EMAIL=marcus@greenscapepro.com
# Optional shared password gate on the dashboard. Leave EMPTY to run open
# (fine for a review deployment). If set, the UI prompts before access.
APP_PASSWORD=
# Used for absolute URLs in Slack notifications. Vercel sets VERCEL_URL
# automatically; set this to your production domain for clean links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Resend webhook (optional) ----
# Shared secret checked on /api/webhooks/resend so bounce/complaint events
# can only be posted by you. Any random string.
RESEND_WEBHOOK_SECRET=
